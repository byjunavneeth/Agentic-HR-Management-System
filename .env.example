# Copy this file to .env and fill in credentials for YOUR own services.
# Never commit .env. All values below are local examples/placeholders.

# PostgreSQL (local PostgreSQL or a hosted service such as Neon)
PG_HOST=localhost
PG_PORT=5432
PG_SSLMODE=prefer
PG_DB=hr_db
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=replace_with_your_admin_password
PG_READONLY_USER=hr_readonly
PG_READONLY_PASSWORD=replace_with_a_strong_readonly_password

# Neo4j (local instance or Neo4j Aura)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_neo4j_password
# Leave blank to use the default database.
NEO4J_DATABASE=

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Web application
# Set a password to enable the basic sign-in screen. Keep the app bound to localhost.
APP_PASSWORD=
# Optional fixed Flask session key. Use a long random value if you enable APP_PASSWORD.
SECRET_KEY=replace_with_a_long_random_secret
PORT=5000

# Set HR_MOCK=1 to run the interface with saved sample responses and no live services.
HR_MOCK=1

# The database setup script drops and recreates project tables. Set this to 1
# ONLY when you intentionally want to reset a dedicated project database.
ALLOW_DB_RESET=0
